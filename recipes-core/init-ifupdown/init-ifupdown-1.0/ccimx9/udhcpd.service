[Unit]
Description=uDHCPd Server for WLAN AP
After=network-online.target hostapd@uap0.service
Wants=network-online.target hostapd@uap0.service

[Service]
Type=simple
ExecStart=/usr/sbin/udhcpd -f /etc/udhcpd.conf
Restart=on-failure
RestartSec=5s
StartLimitInterval=0

[Install]
WantedBy=multi-user.target
