From: peyoot <peyoot@hotmail.com>
Date: Mon, 1 Apr 2025 00:00:00 +0800
Subject: [PATCH] Update to SDL2

---
 plugins/output_viewer/CMakeLists.txt | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/plugins/output_viewer/CMakeLists.txt b/plugins/output_viewer/CMakeLists.txt
index abcdef1..1234567 100644
--- a/plugins/output_viewer/CMakeLists.txt
+++ b/plugins/output_viewer/CMakeLists.txt
@@ -1,12 +1,12 @@
-find_package(SDL)
+find_package(SDL2 REQUIRED)
 
-MJPG_STREAMER_PLUGIN_OPTION(output_viewer "SDL output viewer plugin"
-                            ONLYIF JPEG_LIB SDL_FOUND)
+MJPG_STREAMER_PLUGIN_OPTION(output_viewer "SDL2 output viewer plugin"
+                            ONLYIF JPEG_LIB SDL2_FOUND)
 
 if (PLUGIN_OUTPUT_VIEWER)
-    include_directories(${SDL_INCLUDE_DIR})
+    include_directories(${SDL2_INCLUDE_DIRS})
     MJPG_STREAMER_PLUGIN_COMPILE(output_viewer output_viewer.c)
-    target_link_libraries(output_viewer ${SDL_LIBRARY} ${JPEG_LIB})
+    target_link_libraries(output_viewer ${SDL2_LIBRARIES} ${JPEG_LIB})
 endif()
 
 # vi: ts=4 sw=4
