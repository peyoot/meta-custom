From f70d8be55d34e1c673bf0eb0f6fa77286b246cbc Mon Sep 17 00:00:00 2001
From: Embedded Assistant <support@example.com>
Date: Thu, 11 Jan 2024 16:00:00 +0800
Subject: [PATCH] Fix SDL2 support for output_viewer plugin

---
 .../plugins/output_viewer/CMakeLists.txt          | 10 +++++-----
 .../plugins/output_viewer/output_viewer.c         | 15 +++++++++++----
 2 files changed, 16 insertions(+), 9 deletions(-)

diff --git a/mjpg-streamer-experimental/plugins/output_viewer/CMakeLists.txt b/mjpg-streamer-experimental/plugins/output_viewer/CMakeLists.txt
index 6677bce..d6c49c6 100644
--- a/mjpg-streamer-experimental/plugins/output_viewer/CMakeLists.txt
+++ b/mjpg-streamer-experimental/plugins/output_viewer/CMakeLists.txt
@@ -1,11 +1,11 @@
 
-find_package(SDL)
+find_package(SDL2 REQUIRED)
 
-MJPG_STREAMER_PLUGIN_OPTION(output_viewer "SDL output viewer plugin"
-                            ONLYIF JPEG_LIB SDL_FOUND)
+MJPG_STREAMER_PLUGIN_OPTION(output_viewer "SDL2 output viewer plugin"
+                            ONLYIF JPEG_LIB SDL2_FOUND)
 
 if (PLUGIN_OUTPUT_VIEWER)
-    include_directories(${SDL_INCLUDE_DIR})
+    include_directories(${SDL2_INCLUDE_DIRS})
     MJPG_STREAMER_PLUGIN_COMPILE(output_viewer output_viewer.c)
-    target_link_libraries(output_viewer ${SDL_LIBRARY} ${JPEG_LIB})
+    target_link_libraries(output_viewer ${SDL2_LIBRARIES} ${JPEG_LIB})
 endif()
diff --git a/mjpg-streamer-experimental/plugins/output_viewer/output_viewer.c b/mjpg-streamer-experimental/plugins/output_viewer/output_viewer.c
index dd6c55b..d9f4f41 100644
--- a/mjpg-streamer-experimental/plugins/output_viewer/output_viewer.c
+++ b/mjpg-streamer-experimental/plugins/output_viewer/output_viewer.c
@@ -27,7 +27,7 @@
 #include <pthread.h>
 #include <syslog.h>
 
-#include <SDL/SDL.h>
+#include <SDL2/SDL.h>
 #include <jpeglib.h>
 
 
@@ -295,8 +295,15 @@ void *worker_thread(void *arg)
 
         if(firstrun) {
             /* create the primary surface (the visible window) */
-            screen = SDL_SetVideoMode(rgbimage.width, rgbimage.height, 0, SDL_ANYFORMAT | SDL_HWSURFACE);
-            SDL_WM_SetCaption("MJPG-Streamer Viewer", NULL);
+            SDL_Window *window = SDL_CreateWindow(
+                "MJPG-Streamer Viewer",
+                SDL_WINDOWPOS_UNDEFINED,
+                SDL_WINDOWPOS_UNDEFINED,
+                rgbimage.width,
+                rgbimage.height,
+                SDL_WINDOW_SHOWN
+            );
+            screen = SDL_GetWindowSurface(window);
 
             /* create a SDL surface to display the data */
             image = SDL_AllocSurface(SDL_SWSURFACE, rgbimage.width, rgbimage.height, 24,
@@ -322,7 +329,7 @@ void *worker_thread(void *arg)
         SDL_BlitSurface(image, NULL, screen, NULL);
 
         /* redraw the whole surface */
-        SDL_Flip(screen);
+        SDL_UpdateWindowSurface(window);
     }
 
     pthread_cleanup_pop(1);
