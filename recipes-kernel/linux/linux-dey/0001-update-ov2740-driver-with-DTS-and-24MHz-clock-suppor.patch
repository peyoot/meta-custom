+	/* write msg: 发送寄存器地址 */
 	msgs[0].addr = client->addr;
 	msgs[0].flags = 0;
 	msgs[0].len = sizeof(addr_buf);
 	msgs[0].buf = addr_buf;
+
+	/* read msg: 读数据 */
 	msgs[1].addr = client->addr;
 	msgs[1].flags = I2C_M_RD;
 	msgs[1].len = len;
@@ -397,44 +249,49 @@ static int ov2740_read_reg(struct ov2740 *ov2740, u16 reg, u16 len, u32 *val)
 	if (ret != ARRAY_SIZE(msgs))
