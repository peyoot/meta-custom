# /etc/systemd/system/gpio_demo_ctrl.service
[Unit]
Description=GPIO Guard for Demo Applications (User button 2)
After=graphical.target multi-user.target
Requires=graphical.target

[Service]
Type=simple
ExecStart=/bin/sh /usr/bin/gpio_demo_ctrl.sh
Restart=always
RestartSec=5
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/0
Environment=QT_QPA_PLATFORM=wayland
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/sbin
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8

[Install]
WantedBy=graphical.target
