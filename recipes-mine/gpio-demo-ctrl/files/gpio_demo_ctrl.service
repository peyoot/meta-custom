# /etc/systemd/system/gpio_demo_ctrl.service
[Unit]
Description=GPIO Guard for Demo Application (User button 2)
After=multi-user.target

[Service]
Type=simple
ExecStartPre=/bin/systemctl stop cccs-gs-demo
ExecStart=/bin/bash /opt/gpio_demo_ctrl.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target