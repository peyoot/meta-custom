
DISTRO_FEATURES:append = " rt opengl pam "
DISTRO_FEATURES:remove = " wayland x11 cellular 3g "
DISTRO_FEATURES:remove = " bluetooth wifi "
DISTRO_FEATURES:remove = " systemd"
DISTRO_FEATURES:append = " hwlatdetect sysvinit"
INIT_MANAGER = "sysvinit"
VIRTUAL-RUNTIME_init_manager = "sysvinit"
VIRTUAL-RUNTIME_initscripts = "initscripts"
VIRTUAL-RUNTIME_syslog = "busybox-syslog"
VIRTUAL-RUNTIME_login_manager = "busybox"




# 解决 systemd-compat-units 问题
RDEPENDS:packagegroup-core-boot:remove = "systemd-compat-units"

# 添加必需的启动包
IMAGE_INSTALL:append = " \
    busybox-syslog \
    initscripts \
    sysvinit \
    sysvinit-pidof \
    busybox-hwclock \
    packagegroup-core-boot \
"


IMAGE_INSTALL:append = " \
    qtbase \
    qtbase-plugins \
    qtdeclarative \
    qtquickcontrols2 \
    qtquickcontrols2-qmlplugins \
    qtgraphicaleffects \
    qtgraphicaleffects-qmlplugins \
    qtsvg \
    qtserialport \
    qtwebsockets \
    qt5everywheredemo \
    libdrm \
    libegl \
    libgles2 \
    tslib tslib-calibrate tslib-tests \
    homeaddons touch-calibration \
    iproute2 i2c-tools \
    mesa \
    evtest \
    ttf-dejavu-sans \
    dey-examples-rtc \
"
IMAGE_INSTALL:append = " util-linux-chrt util-linux-taskset util-linux-lscpu"


# 设置默认的Qt平台（针对STM32MP25优化）
QT_QPA_DEFAULT_PLATFORM = "eglfs"
QT_QPA_EGLFS_INTEGRATION = "eglfs_kms"

#QT_QPA_EGLFS_KMS_CONFIG = "/etc/qt5/eglfs_kms_config.json"

GLIBC_GENERATE_LOCALES = "zh_CN.UTF-8 en_GB.UTF-8 en_US.UTF-8"
IMAGE_LINGUAS = "zh-cn"

# 添加DRM/KMS和硬件加速所必须的配置
PACKAGECONFIG:append:pn-qtbase = " kms gbm eglfs gles2 fontconfig jpeg gif "

PACKAGECONFIG:remove:pn-networkmanager = " modemmanager"
PACKAGECONFIG:remove:pn-networkmanager = " ppp"
# 移除不再需要的配置，特别是明确禁用linuxfb和egl
PACKAGECONFIG:remove:pn-qtbase = " glib x11 xcb linuxfb wayland"
PACKAGECONFIG:remove:pn-gstreamer1.0-plugins-bad = " vulkan "

RDEPENDS:packagegroup-dey-core:remove = " connectcore-demo-example xbee-init "
RDEPENDS:packagegroup-dey-network:remove = " ppp modemmanager gstreamer bluetooth wifi "
RDEPENDS:networkmanager:remove = " ppp modemmanager "
RDEPENDS:packagegroup-machine-base:remove = "xbee-init"
# RRECOMMENDS:packagegroup-base:remove = "xbee-init"

# 禁用 swupdate 服务的自动启动（同时会禁用其 socket，因为它们属于同一配方）
SYSTEMD_AUTO_ENABLE:pn-swupdate = "disable"

# 移除蓝牙包组和相关包
IMAGE_INSTALL:remove = " \
    packagegroup-dey-bluetooth \
    bluez5 \
    bluez5-init \
    bluez5-testtools \
    bluez5-obex \
    bluez5-client \
    wpa_supplicant \
    hostapd \
    avahi-daemon \
"


IMAGE_INSTALL:remove = " wayland wayland-protocols libxkbcommon libinput libevdev \
                         mtdev vsftpd lighttpd avahi-daemon hostapd \
                         pulseaudio \
                         tools-debug ppp modemmanager \
                         tcf-agent \
                         swupdate swupdate-www ssh-server-openssh \
                        wpa_supplicant vsftpd bluetoothd \
                       "

SKIP_RECIPE[modemmanager] = "Not needed, no cellular module"
SKIP_RECIPE[ppp] = "Not needed, no cellular module"
SKIP_RECIPE[xbee] = "Not needed, no xbee module"
SKIP_RECIPE[bluez5-init] = "Not needed, no bluetooth"
